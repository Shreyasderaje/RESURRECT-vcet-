# Server-side Gemini API key (NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_api_key_here

# Model configuration
# Note: gemini-3.5-flash is deprecated on Gemini API and auto-routes to newer 3.x Flash models.
# Supported current replacements include gemini-3.8-flash and gemini-3.6-flash (GA).
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# AI Provider selection: "gemini" (default) or "openrouter"
AI_PROVIDER=gemini

# OpenRouter optional provider configuration
# Get a free key at https://openrouter.ai/keys
# Example free model: liquid/lfm-3-1.7b:free (verified: supports response_format + structured_outputs)
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=liquid/lfm-3-1.7b:free
OPENROUTER_TIMEOUT_MS=25000

# Live spot-check rate limits
SPOT_CHECK_MAX_CASES=5
SPOT_CHECK_DAILY_LIMIT=20

# Deterministic demo mode fallback when GEMINI_API_KEY is not configured
ENABLE_DEMO_MODE=True
